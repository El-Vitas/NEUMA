# ─── Postgres ───────────────────────────────────────────────────────────
# POSTGRES_USER is the OWNER (runs DDL/migrations). The backend does NOT use it.
POSTGRES_USER=neuma
POSTGRES_PASSWORD=neuma
POSTGRES_DB=neuma
POSTGRES_PORT=5432
# Password for the least-privilege application role (neuma_app), provisioned on
# first DB init. The backend connects with this role — NOT the owner/superuser.
NEUMA_APP_PASSWORD=change-me-app-role-password

# ─── Database URLs (point at the compose `postgres` service) ─────────────
# Backend runtime: least-privilege app role (DML only, no DDL).
DATABASE_URL=postgresql://neuma_app:change-me-app-role-password@postgres:5432/neuma
# Migrations only: owner role (needs DDL).
MIGRATION_DATABASE_URL=postgresql://neuma:neuma@postgres:5432/neuma

# ─── Backend ────────────────────────────────────────────────────────────
BACKEND_PORT=3000
# MUST be at least 32 characters — change this in production.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_IN=6h
BCRYPT_SALT_ROUNDS=12
# Origen permitido por CORS para el portal.
CORS_ORIGIN=http://localhost:3010
# La dirección con que la gente abre el portal. Con ella se arman los enlaces
# que reciben los agentes; en producción es obligatoria.
PORTAL_URL=http://localhost:3010
LOG_LEVEL=info
# Solo 'true' (o la subnet del proxy, ej. 10.0.0.0/8) cuando el backend esté
# DETRÁS de un reverse proxy que setee X-Forwarded-For. Con acceso directo debe
# quedar 'false', si no el rate limit por IP se puede evadir falsificando el header.
TRUST_PROXY=false

# ─── Portal (staff, Next.js) ─────────────────────────────────────────────
WEB_PORT=3010
# In-network URL the portal container uses to reach the backend service.
INTERNAL_BACKEND_URL=http://backend:3000
# La dirección del MCP como la ve un agente desde fuera, la que el portal le
# muestra a quien crea un token. No es la de adentro de la red de contenedores.
MCP_PUBLIC_URL=http://localhost:3000/api/v1/mcp
# La dirección del socket de edición en vivo como la abre el navegador (ws:// o wss://).
# Se fija al construir la imagen del portal: si cambia, hay que reconstruirla.
COLLABORATION_WS_URL=ws://localhost:3000/api/v1/collaboration
ACCESS_TOKEN_MAX_AGE_SECONDS=21600
