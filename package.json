{
  "name": "@company-brain/monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "backend:dev": "turbo run dev --filter=@company-brain/backend",
    "portal:dev": "turbo run dev --filter=@company-brain/portal",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "check": "sherif && turbo run check",
    "format:ramless": "turbo run format:ramless --concurrency=1",
    "check:ramless": "sherif && turbo run check:ramless --concurrency=1",
    "test:ramless": "turbo run test:ramless --concurrency=1",
    "sherif": "sherif",
    "jscpd": "jscpd",
    "react:doctor": "turbo run react:doctor",
    "portal:build:analyze": "turbo run build:analyze --filter=@company-brain/portal",
    "rules:build": "bun packages/rules-cli/rules-cli.mjs build",
    "rules:query": "bun packages/rules-cli/rules-cli.mjs query",
    "rules:add": "bun packages/rules-cli/rules-cli.mjs add",
    "rules:dump": "bun packages/rules-cli/rules-cli.mjs dump",
    "rules:clean": "bun packages/rules-cli/clean-history.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@next/bundle-analyzer": "16.2.9",
    "concurrently": "^10.0.3",
    "dependency-cruiser": "^17.4.3",
    "jscpd": "^5.0.9",
    "react-scan": "^0.5.7",
    "sherif": "^1.11.1",
    "turbo": "^2.0.0",
    "typescript": "npm:@typescript/typescript6@^6",
    "typescript-7": "npm:typescript@^7"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "postcss": "^8.5.10",
    "qs": "^6.15.2",
    "hono": "^4.12.21",
    "@hono/node-server": "^1.19.13",
    "shell-quote": "^1.8.4"
  }
}
