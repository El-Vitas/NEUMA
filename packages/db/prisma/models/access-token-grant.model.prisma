/// Lo que un token puede hacer en un espacio concreto. Reemplaza, en ese
/// espacio, a lo que el token tiene en todos; sin permisos, lo excluye.
/// Borrar el espacio borra la regla.
model AccessTokenGrant {
  id          String      @id @default(uuid(7))
  tokenId     String
  spaceId     String
  permissions String[]
  token       AccessToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  space       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([tokenId, spaceId])
  @@index([spaceId])
}
