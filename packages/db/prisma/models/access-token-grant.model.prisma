/// What a token may do in one space. Overrides the token's all-spaces permissions
/// there; with no permissions, it excludes the space.
model AccessTokenGrant {
  id          String      @id @default(uuid(7))
  tokenId     String
  spaceId     String
  permissions String[]
  token       AccessToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  space       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([tokenId, spaceId])
  @@index([spaceId])
}
