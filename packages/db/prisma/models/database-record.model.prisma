model DatabaseRecord {
  id             String            @id @default(uuid(7))
  databaseId     String
  title          String
  propertyValues Json
  order          Int               @default(0)
  lifecycle      DatabaseLifecycle @default(ACTIVE)
  createdById    String
  pageId         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  database       Database          @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId, lifecycle, order])
  @@index([databaseId, title])
  @@index([pageId])
}
