/// What a token may do on a page and everything under it.
/// With no permissions, it excludes the page and its descendants. The nearest
/// rule wins, so a deeper rule can reopen or narrow access.
model AccessTokenPageGrant {
  id          String      @id @default(uuid(7))
  tokenId     String
  pageId      String
  permissions String[]
  token       AccessToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([tokenId, pageId])
  @@index([pageId])
}
