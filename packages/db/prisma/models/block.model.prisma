// use prisma-8

/// One row per block; a page is a block of type "page" (ADR 021).
/// Its `searchVector` column and the unaccented trigram index on `text` live outside the contract, because
/// Prisma cannot model a generated tsvector or an index operator class (see the add_block_model migration).
model Block {
  id                    String                     @id(map: "Block_pkey") @default(uuid(7))
  spaceId               String
  parentId              String?
  type                  String
  children              String[]                   @default([]) @noCheck(elementNotNull)
  properties            Jsonb                      @default(json`{}`)
  format                Jsonb?
  text                  String                     @default("")
  textState             Bytes?
  permissions           Jsonb?
  alive                 Boolean                    @default(true)
  lifecycle             pg.enum(PageLifecycle)     @default("ACTIVE")
  lockedAt              TimestamptzJsDate?
  lockedById            String?
  verifiedAt            TimestamptzJsDate?
  verifiedById          String?
  verificationExpiresAt TimestamptzJsDate?
  ownerId               String?
  trashedAt             TimestamptzJsDate?
  purgeAfter            TimestamptzJsDate?
  version               Int                        @default(0)
  createdById           String
  editedById            String
  createdAt             TimestamptzJsDate          @default(now())
  editedAt              temporal.updatedAtJsDate()
  space                 Space                      @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Block_spaceId_fkey", index: "Block_spaceId_lifecycle_idx")
  parent                Block?                     @relation(name: "BlockHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Block_parentId_fkey", index: "Block_parentId_idx")
  verifiedBy            User?                      @relation(name: "BlockVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Block_verifiedById_fkey", index: false)
  owner                 User?                      @relation(name: "BlockOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Block_ownerId_fkey")

  childBlocks           Block[]                    @relation(name: "BlockHierarchy")

  @@index([parentId], map: "Block_parentId_idx")
  @@index([spaceId, lifecycle], map: "Block_spaceId_lifecycle_idx")
  @@index([ownerId], map: "Block_ownerId_idx")
  @@index([purgeAfter], map: "Block_purgeAfter_idx")
  @@index([verificationExpiresAt], map: "Block_verificationExpiresAt_idx")
}
