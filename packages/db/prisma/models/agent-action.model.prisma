/// What an agent did, or tried to do, when writing to Company Brain.
/// One row per write, recorded before writing: no row means no write.
/// No foreign keys to the page or the token, so the record survives their deletion.
model AgentAction {
  id          String             @id @default(uuid(7))
  workspaceId String
  userId      String
  tokenId     String
  tool        String
  pageId      String?
  blockIds    String[]           @default([])
  outcome     AgentActionOutcome
  /// Short summary of the request: the columns changed, the view created.
  detail      Json
  createdAt   DateTime           @default(now())
  /// Null while the outcome is still pending.
  finishedAt  DateTime?
  /// Agent-supplied idempotency id: the same id never runs twice for one token.
  /// Enforced by a partial unique index over pending or done actions only (see its migration).
  requestId   String?

  @@index([workspaceId, createdAt])
  @@index([tokenId, createdAt])
  @@index([pageId])
}
