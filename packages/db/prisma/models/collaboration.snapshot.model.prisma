// use prisma-8
model CollaborationSnapshot {
  id           String                     @id(map: "CollaborationSnapshot_pkey") @default(uuid(7))
  documentName String
  state        Bytes
  updateCount  Int                        @default(0)
  createdAt    TimestamptzJsDate          @default(now())
  updatedAt    temporal.updatedAtJsDate()

  @@unique([documentName], map: "CollaborationSnapshot_documentName_key")
  @@index([updatedAt], map: "CollaborationSnapshot_updatedAt_idx")
}
