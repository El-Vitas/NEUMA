// use prisma-8
model PageVersion {
  id          String            @id(map: "PageVersion_pkey") @default(uuid(7))
  pageId      String
  version     Int
  title       String
  content     Jsonb
  createdById String
  createdAt   TimestamptzJsDate @default(now())
  page        Page              @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PageVersion_pageId_fkey", index: "PageVersion_pageId_createdAt_idx")

  @@unique([pageId, version], map: "PageVersion_pageId_version_key")
  @@index([pageId, createdAt], map: "PageVersion_pageId_createdAt_idx")
}
