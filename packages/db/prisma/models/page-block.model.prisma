/// Each page block, projected from its content for search and linking.
/// A block id is unique within its page, not globally: duplicating a page or
/// moving blocks keeps ids, so the key is the (page, block) pair.
model PageBlock {
  pageId        String
  blockId       String
  spaceId       String
  parentBlockId String?
  position      Int
  type          String
  text          String
  headingPath   String[]
  pageVersion   Int
  searchVector  Unsupported("tsvector")?
  updatedAt     DateTime                 @updatedAt
  page          Page                     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, blockId])
  @@index([blockId])
  @@index([spaceId])
}
