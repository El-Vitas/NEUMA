// use prisma-8
model Page {
  id                    String                     @id(map: "Page_pkey") @default(uuid(7))
  spaceId               String
  parentId              String?
  title                 String
  content               Jsonb
  propertyValues        Jsonb?
  icon                  Jsonb?
  cover                 Jsonb?
  order                 Int                        @default(0)
  lifecycle             pg.enum(PageLifecycle)     @default("ACTIVE")
  lockedAt              TimestamptzJsDate?
  lockedById            String?
  verifiedAt            TimestamptzJsDate?
  verifiedById          String?
  verificationExpiresAt TimestamptzJsDate?
  ownerId               String?
  createdById           String
  updatedById           String
  trashedAt             TimestamptzJsDate?
  /// Set when someone deletes the trashed page forever; it stays restorable until this moment passes.
  purgeAfter            TimestamptzJsDate?
  createdAt             TimestamptzJsDate          @default(now())
  updatedAt             temporal.updatedAtJsDate()
  space                 Space                      @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Page_spaceId_fkey", index: "Page_spaceId_lifecycle_order_idx")
  parent                Page?                      @relation(name: "PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Page_parentId_fkey", index: "Page_parentId_order_idx")
  verifiedBy            User?                      @relation(name: "PageVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Page_verifiedById_fkey", index: false)
  owner                 User?                      @relation(name: "PageOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Page_ownerId_fkey")

  children              Page[]                     @relation(name: "PageHierarchy")
  linksAsSource         PageLink[]                 @relation(name: "PageLinkSource")
  linksAsTarget         PageLink[]                 @relation(name: "PageLinkTarget")
  blocks               PageBlock[]

  @@index([spaceId, lifecycle, order], map: "Page_spaceId_lifecycle_order_idx")
  @@index([parentId, order], map: "Page_parentId_order_idx")
  @@index([ownerId], map: "Page_ownerId_idx")
  @@index([verificationExpiresAt], map: "Page_verificationExpiresAt_idx")
  @@index([purgeAfter], map: "Page_purgeAfter_idx")
}
