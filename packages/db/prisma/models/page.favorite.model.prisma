// use prisma-8
model PageFavorite {
  id        String            @id(map: "PageFavorite_pkey") @default(uuid(7))
  userId    String
  pageId    String
  order     Int               @default(0)
  createdAt TimestamptzJsDate @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PageFavorite_userId_fkey", index: "PageFavorite_userId_order_idx")
  page      Page              @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PageFavorite_pageId_fkey", index: false)

  @@unique([userId, pageId], map: "PageFavorite_userId_pageId_key")
  @@index([userId, order], map: "PageFavorite_userId_order_idx")
}
