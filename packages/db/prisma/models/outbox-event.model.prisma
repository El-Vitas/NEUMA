// use prisma-8

/// What happened, written in the same transaction as the change; each consumer tracks it in its own delivery.
model OutboxEvent {
  id             String            @id(map: "OutboxEvent_pkey") @default(uuid(7))
  aggregateType  String
  aggregateId    String
  eventType      String
  payloadVersion Int               @default(1)
  payload        Jsonb
  idempotencyKey String
  createdAt      TimestamptzJsDate @default(now())

  deliveries     OutboxDelivery[]

  @@unique([idempotencyKey], map: "OutboxEvent_idempotencyKey_key")
  @@index([aggregateType, aggregateId], map: "OutboxEvent_aggregateType_aggregateId_idx")
}
