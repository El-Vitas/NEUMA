// use prisma-8
model PageSchemaProperty {
  id       String                        @id(map: "PageSchemaProperty_pkey") @default(uuid(7))
  pageId   String
  key      String
  label    String
  type     pg.enum(DatabasePropertyType)
  required Boolean                       @default(false)
  options  Jsonb?
  order    Int                           @default(0)
  page     Page                          @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PageSchemaProperty_pageId_fkey", index: "PageSchemaProperty_pageId_key_key")

  @@unique([pageId, key], map: "PageSchemaProperty_pageId_key_key")
  @@index([pageId, order], map: "PageSchemaProperty_pageId_order_idx")
}
