// use prisma-8
model SpaceMember {
  id        String            @id(map: "SpaceMember_pkey") @default(uuid(7))
  spaceId   String
  userId    String
  createdAt TimestamptzJsDate @default(now())
  space     Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "SpaceMember_spaceId_fkey", index: "SpaceMember_spaceId_userId_key")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "SpaceMember_userId_fkey")

  @@unique([spaceId, userId], map: "SpaceMember_spaceId_userId_key")
  @@index([userId], map: "SpaceMember_userId_idx")
}
