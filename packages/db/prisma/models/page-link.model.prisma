// use prisma-8
model PageLink {
  id           String            @id(map: "PageLink_pkey") @default(uuid(7))
  sourcePageId String
  targetPageId String
  createdAt    TimestamptzJsDate @default(now())
  sourcePage   Page              @relation(name: "PageLinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PageLink_sourcePageId_fkey")
  targetPage   Page              @relation(name: "PageLinkTarget", fields: [targetPageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PageLink_targetPageId_fkey")

  @@unique([sourcePageId, targetPageId], map: "PageLink_sourcePageId_targetPageId_key")
  @@index([targetPageId], map: "PageLink_targetPageId_idx")
  @@index([sourcePageId], map: "PageLink_sourcePageId_idx")
}
