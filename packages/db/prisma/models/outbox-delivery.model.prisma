// use prisma-8

/// One consumer's copy of an outbox event: its own claim, retries and failure, so a consumer that takes an
/// event never hides it from the others.
model OutboxDelivery {
  id            String                  @id(map: "OutboxDelivery_pkey") @default(uuid(7))
  eventId       String
  consumer      pg.enum(OutboxConsumer)
  status        pg.enum(OutboxStatus)   @default("PENDING")
  attemptCount  Int                     @default(0)
  nextAttemptAt TimestamptzJsDate       @default(now())
  lastError     Jsonb?
  processedAt   TimestamptzJsDate?
  createdAt     TimestamptzJsDate       @default(now())
  event         OutboxEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OutboxDelivery_eventId_fkey", index: "OutboxDelivery_eventId_consumer_key")

  @@unique([eventId, consumer], map: "OutboxDelivery_eventId_consumer_key")
  @@index([consumer, status, nextAttemptAt], map: "OutboxDelivery_consumer_status_nextAttemptAt_idx")
}
