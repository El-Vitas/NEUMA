// use prisma-8

/// Its `searchVector` column and the unaccented trigram indexes on `title` and `extractedText` live outside the
/// contract, because Prisma cannot model a generated tsvector or an index operator class (see the baseline migration).
model SearchDocument {
  id            String                       @id(map: "SearchDocument_pkey") @default(uuid(7))
  sourceType    pg.enum(SearchSourceType)
  sourceId      String
  spaceId       String
  title         String
  extractedText String
  language      String?
  tags          Jsonb
  properties    Jsonb
  contentType   String
  versionMarker Int
  indexingState pg.enum(SearchIndexingState) @default("PENDING")
  createdAt     TimestamptzJsDate            @default(now())
  updatedAt     temporal.updatedAtJsDate()

  @@unique([sourceType, sourceId], map: "SearchDocument_sourceType_sourceId_key")
  @@index([spaceId, indexingState], map: "SearchDocument_spaceId_indexingState_idx")
  @@index([contentType], map: "SearchDocument_contentType_idx")
  @@check(expression: "((language IS NULL) OR (language = ANY (ARRAY['en'::text, 'es'::text])))", map: "SearchDocument_language_check")
}
