model SearchDocument {
  id            String              @id @default(uuid(7))
  pageId        String              @unique
  spaceId       String
  title         String
  extractedText String
  language      String?
  tags          Json
  properties    Json
  contentType   String
  versionMarker Int
  indexingState SearchIndexingState @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([spaceId, indexingState])
  @@index([contentType])
}
