// use prisma-8
model User {
  id                   String                     @id(map: "User_pkey") @default(uuid(7))
  email                String
  password             String
  name                 String
  role                 pg.enum(UserRole)          @default("CLIENT")
  isActive             Boolean                    @default(true)
  /// Every refresh token carries it; logging out or changing the password raises it, so older tokens stop renewing.
  tokenVersion         Int                        @default(0)
  createdAt            TimestamptzJsDate          @default(now())
  updatedAt            temporal.updatedAtJsDate()

  workspaceMemberships WorkspaceMember[]
  spaceMemberships     SpaceMember[]
  favorites            PageFavorite[]
  verifiedBlocks       Block[]                    @relation(name: "BlockVerifiedBy")
  ownedBlocks          Block[]                    @relation(name: "BlockOwner")
  blockTransactions    BlockTransaction[]
  ownedSpaces          Space[]                    @relation(name: "SpaceOwner")
  pageViews            PageView[]
  accessTokens         AccessToken[]
  notifications        Notification[]
  refreshSessions      RefreshSession[]

  @@index([email], map: "User_email_idx")
  @@unique([email], map: "User_email_key")
  @@index([role], map: "User_role_idx")
}
