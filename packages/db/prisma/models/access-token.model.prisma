/// Key an agent uses to enter Neuma on behalf of its owner.
/// Only the secret's hash is stored; the secret is shown once, at creation.
/// Its power is what it was granted, never more than the owner can do today.
model AccessToken {
  id                   String                 @id @default(uuid(7))
  userId               String
  workspaceId          String
  name                 String
  displayPrefix        String
  secretHash           String                 @unique
  /// Permissions valid in every space the owner sees, including spaces created later.
  allSpacesPermissions String[]               @default([])
  createdAt            DateTime               @default(now())
  lastUsedAt           DateTime?
  expiresAt            DateTime?
  revokedAt            DateTime?
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grants               AccessTokenGrant[]
  pageGrants           AccessTokenPageGrant[]

  @@index([userId])
  @@index([workspaceId])
}
