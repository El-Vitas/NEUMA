// use prisma-8
model FileAsset {
  id               String                      @id(map: "FileAsset_pkey") @default(uuid(7))
  ownerId          String
  workspaceId      String
  pageId           String?
  storageKey       String
  originalFilename String
  mimeType         String
  size             Int
  checksum         String
  lifecycle        pg.enum(FileAssetLifecycle) @default("ACTIVE")
  deletedAt        TimestamptzJsDate?
  createdAt        TimestamptzJsDate           @default(now())
  updatedAt        temporal.updatedAtJsDate()

  @@unique([storageKey], map: "FileAsset_storageKey_key")
  @@index([workspaceId, lifecycle], map: "FileAsset_workspaceId_lifecycle_idx")
  @@index([ownerId, lifecycle], map: "FileAsset_ownerId_lifecycle_idx")
  @@index([pageId, lifecycle], map: "FileAsset_pageId_lifecycle_idx")
}
