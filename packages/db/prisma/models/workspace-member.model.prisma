// use prisma-8
model WorkspaceMember {
  id          String            @id(map: "WorkspaceMember_pkey") @default(uuid(7))
  workspaceId String
  userId      String
  role        pg.enum(UserRole)
  createdAt   TimestamptzJsDate @default(now())
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "WorkspaceMember_workspaceId_fkey", index: "WorkspaceMember_workspaceId_userId_key")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "WorkspaceMember_userId_fkey")

  @@unique([workspaceId, userId], map: "WorkspaceMember_workspaceId_userId_key")
  @@index([userId], map: "WorkspaceMember_userId_idx")
}
