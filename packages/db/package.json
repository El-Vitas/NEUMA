{
  "name": "@neuma/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && cp src/contract/contract.d.ts dist/contract/contract.d.ts",
    "db:generate": "prisma contract emit",
    "db:migrate": "prisma migration plan",
    "db:migrate:deploy": "bun scripts/migrate-deploy.ts",
    "db:push": "prisma db update",
    "db:seed": "bun prisma/seed/main.seed.ts",
    "format": "biome format --write . && prisma contract format",
    "format:check": "biome format .",
    "check": "bun run format:check",
    "db:verify": "prisma db verify"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "dotenv": "^18.0.7",
    "pg": "^8.23.1",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "8.0.0-rc.22",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "yjs": "^13.6.33"
  },
  "types": "./dist/index.d.ts"
}
