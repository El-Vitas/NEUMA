  {
    "id": "function.neuma_set_block_change_xid",
    "label": "Create the function that stamps a block with the id of the transaction that writes it",
    "operationClass": "additive",
    "target": {
      "id": "postgres"
    },
    "precheck": [],
    "execute": [
      {
        "description": "create \"neuma_set_block_change_xid\"",
        "sql": "\nCREATE FUNCTION \"public\".\"neuma_set_block_change_xid\"() RETURNS trigger\nLANGUAGE plpgsql VOLATILE AS $function$\nBEGIN\n  NEW.\"changeXid\" := pg_current_xact_id()::text::bigint;\n  RETURN NEW;\nEND\n$function$"
      }
    ],
    "postcheck": []
  },
  {
    "id": "trigger.Block_change_xid_trigger",
    "label": "Stamp every write of a block with its transaction id",
    "operationClass": "additive",
    "target": {
      "id": "postgres"
    },
    "precheck": [],
    "execute": [
      {
        "description": "create \"Block_change_xid_trigger\"",
        "sql": "\nCREATE TRIGGER \"Block_change_xid_trigger\" BEFORE INSERT OR UPDATE ON \"public\".\"Block\"\nFOR EACH ROW EXECUTE FUNCTION \"public\".\"neuma_set_block_change_xid\"()"
      }
    ],
    "postcheck": [
      {
        "description": "the trigger exists",
        "sql": "\nSELECT count(*) = 1 AS \"ok\" FROM pg_trigger WHERE tgname = 'Block_change_xid_trigger' AND NOT tgisinternal"
      }
    ]
  },
