        "description": "create table \"Block\"",
        "sql": "CREATE TABLE \"public\".\"Block\" (\n  \"alive\" bool DEFAULT true NOT NULL,\n  \"children\" text[] DEFAULT '{}' NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdById\" text NOT NULL,\n  \"editedAt\" timestamptz NOT NULL,\n  \"editedById\" text NOT NULL,\n  \"format\" jsonb,\n  \"id\" text NOT NULL,\n  \"lifecycle\" \"PageLifecycle\" DEFAULT 'ACTIVE'::\"PageLifecycle\" NOT NULL,\n  \"lockedAt\" timestamptz,\n  \"lockedById\" text,\n  \"ownerId\" text,\n  \"parentId\" text,\n  \"permissions\" jsonb,\n  \"properties\" jsonb DEFAULT '{}'::jsonb NOT NULL,\n  \"purgeAfter\" timestamptz,\n  \"spaceId\" text NOT NULL,\n  \"text\" text DEFAULT '' NOT NULL,\n  \"textState\" bytea,\n  \"trashedAt\" timestamptz,\n  \"type\" text NOT NULL,\n  \"verificationExpiresAt\" timestamptz,\n  \"verifiedAt\" timestamptz,\n  \"verifiedById\" text,\n  \"version\" int4 DEFAULT 0 NOT NULL,\n  CONSTRAINT \"Block_pkey\" PRIMARY KEY (\"id\")\n)",
        "params": []
      }
