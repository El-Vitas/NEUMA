{
  "name": "@neuma/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint:check && bun run typecheck",
    "format:ramless": "RAYON_NUM_THREADS=1 biome format --write .",
    "check:ramless": "RAYON_NUM_THREADS=1 biome format . && NODE_OPTIONS=--max-old-space-size=1024 node node_modules/.bin/eslint \"src/**/*.ts\" && NODE_OPTIONS=--max-old-space-size=768 node node_modules/.bin/tsc6 --noEmit",
    "test:cov": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "test:ramless": "bun test --smol"
  },
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neuma/eslint-rules": "workspace:*",
    "@types/bun": "^1.4.2",
    "eslint": "^10.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "zod": "4"
  }
}
