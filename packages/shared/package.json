{
  "name": "@company-brain/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint:check && bun run typecheck"
  },
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bun": "^1.3.14",
    "eslint": "^9.18.0",
    "typescript": "npm:@typescript/typescript6@^6",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "zod": "4"
  }
}
