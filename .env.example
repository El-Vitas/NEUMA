DATABASE_URL=postgresql://neuma:neuma@localhost:5432/neuma
JWT_SECRET=dev-secret-change-me-in-production-minimum-32-chars
CORS_ORIGIN=http://localhost:3010
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
STORAGE_PROVIDER=local
# Portal: reverse proxies in front of it (0 = reached directly, forwards no client address) and whether
# only Cloudflare can reach it (then its cf-connecting-ip header is believed).
TRUSTED_PROXY_COUNT=0
TRUST_CLOUDFLARE_IP=false
