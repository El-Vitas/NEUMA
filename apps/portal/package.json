{
  "name": "@neuma/portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "bun --bun next build",
    "build:analyze": "next experimental-analyze",
    "start": "bun --bun next start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --write --unsafe . && eslint \"{app,modules,shared,config,lib,mocks,types,tests}/**/*.{ts,tsx,js,jsx}\" --fix",
    "lint:check": "biome check . && eslint \"{app,modules,shared,config,lib,mocks,types,tests}/**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental",
    "check": "node --import ../../tooling/depcruise.typescript6.mjs ../../node_modules/.bin/depcruise . -c .depcruise.json --output-type err && bun run format:check && bun run lint:check && bun run typecheck",
    "format:ramless": "RAYON_NUM_THREADS=1 biome format --write .",
    "check:ramless": "NODE_OPTIONS=--max-old-space-size=512 node --import ../../tooling/depcruise.typescript6.mjs ../../node_modules/.bin/depcruise . -c .depcruise.json --output-type err && RAYON_NUM_THREADS=1 biome format . && RAYON_NUM_THREADS=1 biome check . && NODE_OPTIONS=--max-old-space-size=1024 node node_modules/.bin/eslint \"{app,modules,shared,config,lib,mocks,types,tests}/**/*.{ts,tsx,js,jsx}\" && NODE_OPTIONS=--max-old-space-size=768 node ../../node_modules/.bin/tsc -p tsconfig.json --noEmit --incremental",
    "test:ramless": "bun test tests/unit/modules --isolate --timeout 20000 --smol && bun test tests/unit/app tests/unit/i18n tests/unit/portal tests/unit/shared tests/unit/users --isolate --timeout 20000 --smol",
    "test": "bun test tests/unit --isolate --timeout 20000",
    "test:watch": "bun test tests/unit --watch",
    "test:cov": "bun test tests/unit --isolate --timeout 20000 --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "react:doctor": "npx -y react-doctor@0.9.18 . --no-telemetry"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/mdi": "^1.2.3",
    "@mermaid-js/layout-elk": "^1.0.1",
    "@mermaid-js/mermaid-zenuml": "^1.0.1",
    "@neuma/design": "workspace:*",
    "@neuma/shared": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-label": "^2.1.16",
    "@tanstack/react-table": "^9.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.16",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.54.0",
    "mermaid": "^12.1.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-safe-action": "^8.7.3",
    "nuqs": "^2.10.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.29",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yjs": "^13.6.33",
    "zod": "4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@iconify/types": "^2.0.0",
    "@neuma/eslint-rules": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "msw": "^3.0.3",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
