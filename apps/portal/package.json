{
  "name": "@company-brain/portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "bun --bun next build",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "bun --bun next start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --write --unsafe . && eslint \"{app,modules,shared,config,lib,mocks,types,tests}/**/*.{ts,tsx,js,jsx}\" --fix",
    "lint:check": "biome check . && eslint \"{app,modules,shared,config,lib,mocks,types,tests}/**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental",
    "check": "depcruise . -c .depcruise.json --output-type err && bun run format:check && bun run lint:check && bun run typecheck",
    "format:ramless": "RAYON_NUM_THREADS=1 biome format --write .",
    "check:ramless": "NODE_OPTIONS=--max-old-space-size=512 node ../../node_modules/.bin/depcruise . -c .depcruise.json --output-type err && RAYON_NUM_THREADS=1 biome format . && RAYON_NUM_THREADS=1 biome check . && NODE_OPTIONS=--max-old-space-size=1024 node node_modules/.bin/eslint \"{app,modules,shared,config,lib,mocks,types,tests}/**/*.{ts,tsx,js,jsx}\" && NODE_OPTIONS=--max-old-space-size=768 node ../../node_modules/.bin/tsc -p tsconfig.json --noEmit --incremental",
    "test:ramless": "bun test tests/unit/modules --isolate --timeout 20000 --smol && bun test tests/unit/app tests/unit/i18n tests/unit/portal tests/unit/shared tests/unit/users --isolate --timeout 20000 --smol",
    "test": "bun test tests/unit --isolate --timeout 20000",
    "test:watch": "bun test tests/unit --watch",
    "test:cov": "bun test tests/unit --isolate --coverage",
    "react:doctor": "npx -y react-doctor@latest ."
  },
  "dependencies": {
    "@company-brain/design": "workspace:*",
    "@company-brain/shared": "workspace:*",
    "@hocuspocus/provider": "^4.4.0",
    "@iconify-json/logos": "^1.2.12",
    "@iconify-json/mdi": "^1.2.3",
    "@mermaid-js/layout-elk": "^0.2.2",
    "@mermaid-js/mermaid-zenuml": "^0.2.3",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-label": "^2.1.9",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "^0.574.0",
    "mermaid": "^11.16.1",
    "next": "16.2.9",
    "next-intl": "^4.13.4",
    "next-safe-action": "^8.5.4",
    "nuqs": "^2.8.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.6",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.31",
    "zod": "4"
  },
  "devDependencies": {
    "@company-brain/eslint-rules": "workspace:*",
    "@happy-dom/global-registrator": "^20.10.6",
    "@iconify/types": "^2.0.0",
    "@next/bundle-analyzer": "16.2.9",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-better-tailwindcss": "^4.4.1",
    "msw": "^2.14.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
