{
  "name": "@company-brain/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "mcp": "bun src/modules/mcp/mcp.main.ts",
    "start": "bun src/main.ts",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "lint": "biome check --write --unsafe src tests && eslint \"{src,tests}/**/*.ts\" --fix",
    "lint:check": "biome check src tests && eslint \"{src,tests}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental",
    "check": "depcruise . -c .depcruise.json --output-type err && concurrently --names \"FORMAT,LINT,TYPES\" --prefix-colors \"cyan,yellow,magenta\" \"bun run format:check\" \"bun run lint:check\" \"bun run typecheck\"",
    "test": "bun test tests/unit tests/integration --timeout 30000",
    "test:watch": "bun test tests/unit tests/integration --watch"
  },
  "dependencies": {
    "@company-brain/db": "workspace:*",
    "@company-brain/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^9.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "fastify": "5.10.0",
    "nestjs-pino": "^4.6.1",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4"
  },
  "devDependencies": {
    "@company-brain/eslint-rules": "workspace:*",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.4.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "fishery": "^2.4.0",
    "globals": "^17.0.0",
    "pg": "^8.14.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "typescript": "npm:@typescript/typescript6@^6",
    "typescript-eslint": "^8.20.0"
  }
}
